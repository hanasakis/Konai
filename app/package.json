{
  "name": "konai",
  "version": "1.0.0",
  "description": "Konai - a free, clean-room Markdown editor for Windows",
  "author": "Konai Project",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win --x64",
    "dist:dir": "electron-vite build && electron-builder --win --x64 --dir",
    "pack:portable": "electron-vite build && electron-builder --win --x64 --dir && node scripts/make-portable.mjs",
    "icons": "node scripts/build-icons.mjs",
    "verify:cleanroom": "node scripts/verify-cleanroom.mjs",
    "verify:licenses": "node scripts/vendor-licenses.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.18.6",
    "@codemirror/commands": "6.8.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.11.0",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.5.11",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/common": "^1.2.0",
    "@lezer/highlight": "1.2.1",
    "@lezer/markdown": "1.8.1",
    "chokidar": "4.0.3",
    "docx": "9.15.4",
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.3",
    "mathjax": "4.1.3",
    "mermaid": "11.13.0",
    "node-emoji": "2.2.0",
    "pdf-lib": "1.17.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@types/markdown-it": "14.1.2",
    "@types/node": "24.3.0",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "@vitejs/plugin-react": "5.1.0",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}